PORT=5000
MONGODB_URI=mongodb://localhost:27017/
JWT_SECRET=change_this_to_a_long_random_secret
CLIENT_URL=http://localhost:5173

# Email (Gmail App Password) - OTP / verification mail ke liye
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password

# Razorpay (https://dashboard.razorpay.com -> Settings -> API Keys). Pehle Test Mode keys use karo.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook secret (Dashboard -> Webhooks me jo secret set karo wahi). Optional par recommended.
RAZORPAY_WEBHOOK_SECRET=
